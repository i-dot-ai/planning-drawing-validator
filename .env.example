# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables used by the planning-drawing-validator
# and its associated applications (demo-app, evaluation-app).
#
# QUICK START:
# -----------
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Configure LiteLLM gateway credentials:
#    - Set IAI_LITELLM_API_KEY=your-api-key
#    - Set IAI_LITELLM_CHAT_MODEL=gemini/gemini-2.5-flash (or any LiteLLM model)
#
# 3. (Optional) Configure database for evaluation-app:
#    - For Docker: Keep DATABASE_URL as-is
#    - For local dev: Set USE_SQLITE=true
#
# 4. (Optional) Enable LLM tracing via Langfuse
#
# ============================================================================

# Database Configuration (Evaluation App Only)
# ============================================================================
# NOTE: Demo app is STATELESS and does not use a database
#
# EVALUATION SYSTEM (evaluation-app/docker-compose.yml):
#   - Container: db-evaluation
#   - Database: review_dev
#   - Port: 5432
#   - User: review_user / review_password  # pragma: allowlist secret
#
# For local development (accessing Docker database from host):
DATABASE_URL=postgresql://review_user:review_password@localhost:5432/review_dev
#
# For Docker Compose (backend container connecting to database container):
# DATABASE_URL=postgresql://review_user:review_password@db-evaluation:5432/review_dev
# ============================================================================

# SQLite (Evaluation App - local development without Docker)
# Set USE_SQLITE=true to use local SQLite database instead of PostgreSQL
USE_SQLITE=false
SQLITE_DB_PATH=data/review.db

# Database Connection Pool Configuration (Evaluation App - PostgreSQL only)
DB_POOL_SIZE=20              # Maximum number of persistent connections
DB_POOL_MAX_OVERFLOW=10      # Additional connections allowed temporarily
DB_POOL_RECYCLE=3600         # Recycle connections after this many seconds (1 hour)
DB_POOL_TIMEOUT=30           # Timeout for acquiring connection from pool (seconds)

# Storage Configuration (Evaluation App Only)
# ============================================================================
# NOTE: Demo app is STATELESS - files are uploaded directly to API
#
# Evaluation app can use S3/MinIO for persistent document storage or local files
# Set USE_LOCAL_STORAGE=true to store files locally instead of S3/MinIO
USE_LOCAL_STORAGE=false

# S3/MinIO Configuration (Evaluation App - required when USE_LOCAL_STORAGE=false)
# IMPORTANT: Change these credentials for production!
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=review-documents
S3_SECURE=false

# Application Configuration
PYTHONUNBUFFERED=1

# ============================================================================
# LiteLLM Gateway Configuration (Model Agnostic)
# ============================================================================
# The application uses LiteLLM for model-agnostic access to any Vision LLM provider
# (OpenAI, Anthropic, Google, Azure, etc.)

# Project name for tracking
IAI_LITELLM_PROJECT_NAME=drawing-validator

# Model to use (format: provider/model-name)
# Examples:
#   - gemini/gemini-2.5-flash (Google)
#   - openai/gpt-4o (OpenAI)
#   - anthropic/claude-sonnet-4-20250514 (Anthropic)
# See https://docs.litellm.ai/docs/providers for full list
IAI_LITELLM_CHAT_MODEL=gemini/gemini-2.5-flash

# LiteLLM gateway URL
IAI_LITELLM_API_BASE=https://your-litellm-gateway.example.com

# API key for gateway authentication
IAI_LITELLM_API_KEY=

# ============================================================================
# Langfuse Configuration (optional - for LLM tracing and observability)
# ============================================================================
# Integrated with LiteLLM gateway for automatic tracing

IAI_LITELLM_LANGFUSE_PUBLIC_KEY=pk-lf-...
IAI_LITELLM_LANGFUSE_SECRET_KEY=sk-lf-...
IAI_LITELLM_LANGFUSE_HOST=https://cloud.langfuse.com
